"size":[620,330],"flags":{},"order":18,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":4},{"localized_name":"image","name":"image","shape":7,"type":"IMAGE","link":12},{"localized_name":"image_b","name":"image_b","shape":7,"type":"IMAGE","link":18},{"localized_name":"prompt","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"grounding_px","name":"grounding_px","shape":7,"type":"INT","widget":{"name":"grounding_px"},"link":null},{"localized_name":"system_prompt","name":"system_prompt","shape":7,"type":"STRING","widget":{"name":"system_prompt"},"link":null}],"outputs":[{"localized_name":"CONDITIONING","name":"CONDITIONING","type":"CONDITIONING","links":[22]}],"properties":{"Node name for S&R":"Krea2EditGroundedEncode","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Dress the woman from the primary reference in the bright yellow hooded raincoat shown in the second reference. Keep her exact face, hair, body proportions, pose and the plain studio background unchanged. Preserve the exact facial identity.",768,""]},{"id":85,"type":"Krea2EditGroundedEncode","pos":[1620,250],"size":[225,0],"flags":{"collapsed":true},"order":19,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":5},{"localized_name":"image","name":"image","shape":7,"type":"IMAGE","link":13},{"localized_name":"image_b","name":"image_b","shape":7,"type":"IMAGE","link":19},{"localized_name":"prompt","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"grounding_px","name":"grounding_px","shape":7,"type":"INT","widget":{"name":"grounding_px"},"link":null},{"localized_name":"system_prompt","name":"system_prompt","shape":7,"type":"STRING","widget":{"name":"system_prompt"},"link":null}],"outputs":[{"localized_name":"CONDITIONING","name":"CONDITIONING","type":"CONDITIONING","links":[23]}],"title":"negative (leave empty)","properties":{"Node name for S&R":"Krea2EditGroundedEncode","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["",768,""]},{"id":90,"type":"LoadImage","pos":[640,640],"size":[520,440],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"choose file to upload","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[17,18,19,20]},{"localized_name":"MASK","name":"MASK","type":"MASK","links":null}],"properties":{"Node name for S&R":"LoadImage","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["test_outfit_00001_.png","image"]},{"id":92,"type":"VAEEncode","pos":[1250,970],"size":[225,0],"flags":{"collapsed":true},"order":17,"mode":0,"inputs":[{"localized_name":"pixels","name":"pixels","type":"IMAGE","link":17},{"localized_name":"vae","name":"vae","type":"VAE","link":8}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[21]}],"properties":{"Node name for S&R":"VAEEncode","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[]},{"id":100,"type":"Note","pos":[60,540],"size":[480,150],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"Model files","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Files (auto-downloadable via the manager links):\n- krea2_turbo_fp8_scaled (or krea2_raw_bf16 - see GENERATE note)\n- qwen3vl_4b_fp8_scaled text encoder, type 'krea2'\n- qwen_image_vae\n- krea2_identity_edit_v1_2.safetensors LoRA (this model)"],"color":"#432","bgcolor":"#653"},{"id":101,"type":"Note","pos":[640,330],"size":[520,190],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"title":"How inputs work","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["PRIMARY REFERENCE — always the SUBJECT.\n\nThis slot holds the person/character the output must MATCH: their face,\nhair, body and pose are what gets preserved. In single-image mode it is\nsimply the image being edited.\n\nOrder rule (this build): subject = image 1 (here), outfit/reference =\nimage 2 (group 2). The output always matches THIS image.\nInputs around 1MP work best; stay at/below ~1.5MP for two-image edits."],"color":"#432","bgcolor":"#653"},{"id":102,"type":"Note","pos":[640,1130],"size":[520,210],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"Enable for two-image edits","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["SECONDARY REFERENCE — the OUTFIT (or garment/style to transfer).\n\nPut the clothing you want applied to the subject here: a flat-lay,\nproduct shot or worn reference all work. The subject's identity is NOT\ntaken from this image — only the outfit.\n\nOrder rule: subject = image 1 (group 1), outfit = image 2 (here).\nEnabled by default in this build. To go back to a plain single-image\neditor, bypass this group (right-click its title bar -> Bypass) and\ndescribe the outfit in words instead."],"color":"#432","bgcolor":"#653"},{"id":103,"type":"Note","pos":[1620,360],"size":[620,300],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"title":"Writing instructions","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Write the edit in plain English. The subject comes from the PRIMARY\nreference, the outfit from the SECONDARY one:\n\n  'Dress the woman from the primary reference in the jacket shown in\n   the second reference.'\n  'Put this outfit on her, keeping her face and pose unchanged.'\n  'Change her outfit to a red raincoat.'   (single-image mode)\n\nBecause the output always matches the primary reference, it helps to\nsay so explicitly:\n  'Keep her exact face, hair, body proportions and pose unchanged.'\n\nUnique face coming out generic? Append:\n  'Preserve the exact facial identity - distinguishing features: ...'\nand describe what makes the face distinctive.\n\nOutfit not transferring? Raise ref_boost (group 4) above 1.0.\nSubject drifting? Raise ref_boost_a instead.\n\ngrounding_px: how large the model 'sees' the input while reading your\ninstruction. 384-768 is the trained range. Getting doubled/split\ncompositions? LOWER it. The collapsed node below is the negative -\nonly used at CFG > 1; keep its prompt empty."],"color":"#432","bgcolor":"#653"},{"id":104,"type":"Note","pos":[2320,230],"size":[420,420],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"title":"Fidelity dial","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["THE FIDELITY DIAL - how hard the model looks at each reference.\n\nIMPORTANT (this build): the dials follow the image slots, not the roles.\nInternally the LAST reference gets ref_boost and earlier ones get\nref_boost_a. Since the SUBJECT is now image 1, the subject dial is\nref_boost_a.\n\n  ref_boost_a = SUBJECT (image 1)  -> pre-set to 4.0\n  ref_boost   = OUTFIT  (image 2)  -> pre-set to 1.0\n\nScale (applies to whichever dial):\n  1.0 = classic v1.1 behavior\n  4.0 = strong face + body likeness, more reliable edits\n  >10 = over-copy: removals/replacements start failing\n  <1  = suppress that reference (creative freedom)\n\nRaise ref_boost above 1 only if the outfit is not transferring; too high\nand it starts dragging the reference body/pose in with the garment.\n\nfit_mode: how inputs fit a different output aspect ratio.\nfit = resample to the output shape (default, recommended);\ncrop (legacy) = center-crop, only for v1/v1.1 weights."],"color":"#432","bgcolor":"#653"},{"id":105,"type":"Note","pos":[2800,490],"size":[320,280],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"Sampling","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Turbo model: 10 steps, cfg 1.\n\nStep dial:\n  8  = stronger composition/instruction adherence\n  12 = more face detail\n  10 = balanced\n\nUsing krea2_raw instead of turbo:\n40 steps, cfg 3-4 (negative then matters)."],"color":"#432","bgcolor":"#653"},{"id":106,"type":"Note","pos":[621.729873331005,-662.2754399161804],"size":[574.171875,371.515625],"flags":{},"order":12,"mode":0,"inputs":[],"outputs":[],"title":"README","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["KREA 2 IDENTITY EDIT  -  v1.2 (Fidelity update)  ·  OUTFIT-SWAP LAYOUT\nUse an image like a LoRA: your subject goes in as the primary reference, plain-English\ninstructions do the rest.\n\nREFERENCE ORDER (this build):\n  PRIMARY   (group 1) = the SUBJECT  - the output always matches this person\n  SECONDARY (group 2) = the OUTFIT   - the garment/style transferred onto them\n\nQUICK START:  1) subject in group 1   2) outfit in group 2   3) write the instruction\nin group 3   4) Queue.\n\nFidelity (group 4) follows the SLOTS, not the roles: ref_boost_a = image 1 = subject\n(pre-set 4.0), ref_boost = image 2 = outfit (pre-set 1.0). Swap the images and you\nmust swap these too.\n\nGroup 2 is ENABLED by default here. Bypass it (right-click its title -> Bypass) for a\nplain single-image editor and describe the outfit in words instead.\n\nRequires the comfyui-krea2edit nodes from this release or newer.\ngithub.com/lbouaraba/comfyui-krea2edit   -   huggingface.co/conradlocke/krea2-identity-edit"],"color":"#232","bgcolor":"#353"},{"id":107,"type":"Note","pos":[1250,-140],"size":[270,110],"flags":{},"order":13,"mode":0,"inputs":[],"outputs":[],"title":"Resolution","properties":{"Node name for S&R":"Note","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Output resolution — MATCH THIS TO THE PRIMARY (SUBJECT) IMAGE.\n\nThe output latent is built from these numbers, not from the subject, so\nif the ratio here disagrees with the subject image, fit_mode (\"fit\")\nresamples the subject into this shape and the framing/proportions shift.\n\nSet aspect_ratio to whichever preset is closest to your subject:\n  portrait photo  -> 2:3   (current: 816x1224)\n  portrait std    -> 3:4\n  tall/phone      -> 9:16\n  square          -> 1:1\n\nMEGAPIXELS: 1.0 is the model's sweet spot — leave it here.\n  1.0 MP  = correct for edits, and for ALL two-image edits\n  <=1.5MP = hard ceiling for two-image edits\n  >1.5MP  = single-subject edits only, quality falls off"],"color":"#432","bgcolor":"#653"}],"links":[[1,55,0,71,0,"MODEL"],[2,71,0,79,0,"MODEL"],[3,79,0,53,0,"MODEL"],[4,56,0,84,0,"CLIP"],[5,56,0,85,0,"CLIP"],[6,57,0,54,1,"VAE"],[7,57,0,73,1,"VAE"],[8,57,0,92,1,"VAE"],[9,83,0,82,0,"INT"],[10,83,1,82,1,"INT"],[11,72,0,73,0,"IMAGE"],[12,72,0,84,1,"IMAGE"],[13,72,0,85,1,"IMAGE"],[14,72,0,79,5,"IMAGE"],[15,73,0,79,1,"LATENT"],[16,57,0,79,4,"VAE"],[17,90,0,92,0,"IMAGE"],[18,90,0,84,2,"IMAGE"],[19,90,0,85,2,"IMAGE"],[20,90,0,79,6,"IMAGE"],[21,92,0,79,2,"LATENT"],[22,84,0,53,1,"CONDITIONING"],[23,85,0,53,2,"CONDITIONING"],[24,82,0,53,3,"LATENT"],[25,53,0,54,0,"LATENT"],[26,54,0,29,0,"IMAGE"],[27,82,0,79,7,"LATENT"]],"groups":[{"id":1,"title":"MODELS","bounding":[40,-240,540,950],"color":"#3f789e","flags":{}},{"id":2,"title":"1 · PRIMARY REFERENCE — SUBJECT","bounding":[620,-240,580,790],"color":"#8A8","flags":{}},{"id":3,"title":"2 · SECONDARY REFERENCE — OUTFIT","bounding":[620,560,580,810],"color":"#3f789e","flags":{}},{"id":4,"title":"3 · INSTRUCTION","bounding":[1600,-240,680,930],"color":"#b58b2a","flags":{}},{"id":5,"title":"4 · FIDELITY","bounding":[2300,-240,460,910],"color":"#c15f3c","flags":{}},{"id":6,"title":"5 · GENERATE","bounding":[2780,-240,1200,1030],"color":"#3f789e","flags":{}}],"config":{},"extra":{"frontendVersion":"1.45.19","ds":{"scale":0.5780770083431641,"offset":[160.92679367696041,946.1865658093775]},"VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true,"comfyui_mcp":{"workflow_uuid":"e66e531b-a4ca-4bee-8a11-12df34b830e2"},"ue_links":[],"links_added_by_ue":[]},"version":0.4}